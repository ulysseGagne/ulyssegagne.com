---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { address } from '../address';
import { moved } from '../moved';

// The pages that do exist: every page of site/, except the hidden ones.
const pages = (await getCollection('pages', (page) => !page.data.noindex))
	.map((page) => ({ href: address(page.id), title: page.data.title }))
	.sort((a, b) => a.href.localeCompare(b.href));
---

<Base title="Ce fichier n’existe pas" description="Il n’y a pas de page à cette adresse." noindex>
	<script is:inline slot="head" define:vars={{ moved }}>
		// GitHub Pages answers every address without a file with this page. Two kinds go on to a page that exists:
		// an address ending in a slash is the same page without it (ulyssegagne.com/tuteur/ is /tuteur),
		// and a page that moved is at its new address (ulyssegagne.com/course is /a-propos/course: src/moved.ts).
		// The head hides the page and leaves before anything shows. The new address starts with one slash and keeps this origin:
		// ulyssegagne.com//example.com/ must not leave the site.
		{
			const { pathname, search, hash, origin } = location;
			const path = '/' + pathname.replace(/^\/+|\/+$/g, '');
			const to = moved[path] ?? (path === pathname ? null : path);
			if (to) {
				document.documentElement.style.display = 'none';
				location.replace(origin + to + search + hash);
			}
		}
	</script>
	<h1>Ce fichier n’existe pas</h1>
	<p>Voici ceux qui existent&nbsp;:</p>
	<ul>
		{
			pages.map((page) => (
				<li>
					<a href={page.href}>{page.title}</a>
				</li>
			))
		}
	</ul>
	<script is:inline>
		// The path at the top shows the address that was asked for.
		{
			const home = document.createElement('a');
			home.href = '/';
			home.textContent = 'ulyssegagne.com';
			const crumbs = location.pathname.split('/').filter(Boolean).flatMap((part) => {
				const sep = document.createElement('span');
				sep.className = 'sep';
				sep.textContent = '/';
				const name = document.createElement('span');
				name.className = 'here';
				try {
					name.textContent = decodeURIComponent(part);
				} catch {
					name.textContent = part;
				}
				return [sep, name];
			});
			document.querySelector('.path').replaceChildren(home, ...crumbs);
		}
	</script>
</Base>
